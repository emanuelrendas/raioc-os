{
  "name": "raioc-os",
  "version": "1.0.0",
  "description": "Rendas AI Intelligence Operating Center - Autonomous Backend Operating System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node src/api/server.js",
    "start": "node src/index.js",
    "start:daemon": "node src/workers/daemon-entrypoint.js",
    "start:container": "node src/server.js",
    "cycle": "node src/core/run-cycle.js",
    "build": "node tools/sync-site-pages.mjs",
    "test": "node --test 'tests/*.test.js' 'tests/**/*.test.js'",
    "test:ci": "node --test tests/vercel-entrypoint.test.js tests/frontend-source-of-truth-mission4.test.js tests/schema-provenance-mission3.test.js tests/security-mission2-hardening.test.js",
